{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "schedule": ["* * * * 1-5"],
  "timezone": "America/Los_Angeles",
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "groupName": "Routine updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Each @vitejs plugin major peers on one vite major, so they can only land together.",
      "groupName": "vite",
      "matchPackageNames": ["vite", "@vitejs/**"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "typescript-eslint's peer range; raise when it supports newer TypeScript.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ],
  "constraints": {
    "npm": "^12.0.0"
  }
}
