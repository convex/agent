{
  "name": "@convex-dev/agent",
  "description": "Convex component for AI agents with persistent chat threads, tool calling, streaming, and RAG.",
  "repository": "github:convex/agent",
  "homepage": "https://docs.convex.dev/agents",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/agent/issues"
  },
  "version": "0.7.8",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "ai",
    "agent",
    "ai-agent",
    "llm",
    "tool-calling",
    "chat",
    "threads",
    "streaming",
    "rag"
  ],
  "type": "module",
  "scripts": {
    "setup": "node setup.cjs --init",
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preversion": "npm ci && npm run build:clean && npm run test && npm run lint && npm run typecheck",
    "alpha": "npm version prerelease --preid alpha && npm publish --tag alpha && git push --follow-tags",
    "release": "npm version patch && npm publish && git push --follow-tags",
    "version": "(npm whoami || npm login) && vim -c 'normal o' -c 'normal o## '$npm_package_version CHANGELOG.md && prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "files": [
    "dist",
    "src",
    "MIGRATION.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "default": "./dist/validators.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "ai": "^7.0.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.127",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@ai-sdk/google": "4.0.94",
    "@ai-sdk/groq": "4.0.60",
    "@ai-sdk/openai": "4.0.92",
    "@ai-sdk/otel": "1.0.138",
    "@ai-sdk/provider": "4.0.27",
    "@ai-sdk/provider-utils": "5.0.59",
    "@convex-dev/ai-sdk-provider": "0.1.0",
    "@convex-dev/eslint-plugin": "5.0.0",
    "@convex-dev/rag": "0.7.8",
    "@convex-dev/rate-limiter": "0.4.2",
    "@convex-dev/workflow": "0.4.10",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "9.39.5",
    "@hookform/resolvers": "5.9.1",
    "@langchain/textsplitters": "1.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "7.0.138",
    "chokidar-cli": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "0.1.128",
    "convex-test": "0.0.62",
    "dayjs": "1.11.23",
    "dotenv": "18.0.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "lucide-react": "1.55.0",
    "openai": "7.32.0",
    "pkg-pr-new": "0.0.91",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "readline": "1.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "3.25.76"
  },
  "types": "./dist/vercel/index.d.ts",
  "module": "./dist/vercel/index.js",
  "optionalDependencies": {
    "@ungap/structured-clone": "^1.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
