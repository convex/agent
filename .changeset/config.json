{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "convex/agent",
      "template": "\n\n- {summary}"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "format": "prettier",
  "bumpVersionsWithWorkspaceProtocolOnly": true,
  "ignore": ["@convex-dev/agent-playground"]
}
